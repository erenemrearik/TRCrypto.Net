<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Yalnizca yayinlanabilir kutuphaneler icin (dokuman Bolum 16.3) -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;netstandard2.0;netstandard2.1</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Authors>TRCrypto Contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://erenemrearik.github.io/TRCrypto.Net/</PackageProjectUrl>
    <PackageTags>crypto;cryptocurrency;exchange;trading;turkey;turkiye;api;client</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/erenemrearik/TRCrypto.Net</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'netstandard2.1'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    SourceLink icin ayri bir paket kullanilmaz. .NET 8'den beri SDK'nin kendisi
    Microsoft.SourceLink.GitHub'i tasiyor; paketi ayrica eklemek yalnizca ikinci bir
    surum zinciri yaratiyordu. Nitekim o zincir bir guvenlik danisma kaydiyla derlemeyi
    durdurdu: paketin bagimliligi Microsoft.Build.Tasks.Git 8.0.0 icin NU1902 uretildi ve
    uyarilar hata sayildigi icin restore basarisiz oldu.

    Yukaridaki PublishRepositoryUrl, EmbedUntrackedSources ve ContinuousIntegrationBuild
    ozellikleri SDK'nin SourceLink'ini yapilandirir; paket olmadan da calisirlar.
  -->

  <!--
    Paket simgesi uc paket icin de aynidir; marka tek yerde tutulur.
    NuGet yalnizca raster kabul eder, bu yuzden SVG degil PNG kullanilir.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../assets/logo-512.png"
          Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>
</Project>
