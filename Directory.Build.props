<Project>

  <!-- Tum projeler icin ortak ayarlar. Paket metadata'si src/Directory.Build.props icindedir. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Deterministic / reproducible build (dokuman Bolum 6) -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Product>TRCrypto.Net</Product>
    <Company>TRCrypto Contributors</Company>
    <Copyright>Copyright (c) 2026 TRCrypto Contributors</Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

</Project>
