<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Bu depo yalnizca nuget.org kullanir.
    Ust dizinlerdeki (or. kurumsal) kaynaklar <clear /> ile devre disi birakilir:
      - Central Package Management, birden fazla kaynakta source mapping ister (NU1507)
      - Acik kaynak bir kutuphanenin bagimliliklari kurumsal bir feed'e sorulmamalidir
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
